{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["dom", "dom.iterable", "esnext"],
		"types": ["node", "react", "react-dom"],
		"allowJs": false,
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"incremental": true,
		"plugins": [{ "name": "next" }],
		"paths": { "@/*": ["./src/*"] }
	},
	"include": [
		"**/*.ts",
		"**/*.tsx",
		".next/types/**/*.ts",
		".next/dev/types/**/*.ts",
		".next/test-public/types/**/*.ts",
		".next/test-editor/types/**/*.ts",
		".next/test-editor/dev/types/**/*.ts",
		".next/test-public/dev/types/**/*.ts"
	],
	"exclude": ["node_modules"]
}
